# ВНИМАНИЕ: это образец. Настоящие значения — только в .env, который в .gitignore.
# Никогда не коммить реальный токен: любой, у кого есть репозиторий, получит бота.

# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-ЗАМЕНИТЕ-НА-СВОЙ-ТОКЕН

# Ваш chat_id (узнать через getUpdates, см. README)
CHAT_ID=000000000

# Домен сайта, которому разрешено обращаться к API.
ALLOWED_ORIGIN=https://plrtp.ru

PORT=3000
